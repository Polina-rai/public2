import dash
from dash import dcc, html, dash_table
from dash.dependencies import Input, Output
import plotly.express as px
import pandas as pd

# Инициализация приложения
app = dash.Dash(__name__)

# Пример данных
data = {
    'Дата': pd.date_range(start='2023-01-01', periods=12, freq='M'),
    'Доходы': [100, 150, 200, 250, 300, 350, 400, 450, 500, 550, 600, 650],
    'Расходы': [80, 90, 120, 150, 180, 200, 220, 240, 260, 280, 300, 320],
    'Прибыль': [20, 60, 80, 100, 120, 150, 180, 210, 240, 270, 300, 330],
    'Категория': ['Аренда', 'Зарплата', 'Маркетинг', 'Аренда', 'Зарплата', 
                  'Маркетинг', 'Аренда', 'Зарплата', 'Маркетинг', 'Аренда', 'Зарплата', 'Маркетинг']
}
df = pd.DataFrame(data)

# Макет дашборда
app.layout = html.Div([
    html.H1("Финансовый дашборд", style={'textAlign': 'center'}),
    
    # Выпадающий список
    html.Label("Выберите период анализа:"),
    dcc.Dropdown(
        id='period-dropdown',
        options=[
            {'label': 'Месяц', 'value': 'month'},
            {'label': 'Квартал', 'value': 'quarter'},
            {'label': 'Год', 'value': 'year'}
        ],
        value='month',
        style={'width': '50%', 'margin': '10px'}
    ),
    
    # Индикаторы
    html.Div([
        html.Div([
            html.H4("Текущая прибыль"),
            dcc.Graph(id='profit-indicator', 
                     figure={
                         'data': [],
                         'layout': {
                             'title': f"{df['Прибыль'].iloc[-1]} тыс. руб.",
                             'height': 150
                         }
                     })
        ], className='six columns'),
        
        html.Div([
            html.H4("Общие расходы"),
            dcc.Graph(id='expense-indicator',
                     figure={
                         'data': [],
                         'layout': {
                             'title': f"{df['Расходы'].sum()} тыс. руб.",
                             'height': 150
                         }
                     })
        ], className='six columns'),
    ], className='row'),
    
    # График временного ряда
    dcc.Graph(id='time-series-graph'),
    
    # Круговая диаграмма
    dcc.Graph(id='pie-chart'),
    
    # Гистограмма
    dcc.Graph(id='histogram'),
    
    # Таблица
    html.H3("Ключевые финансовые показатели"),
    dash_table.DataTable(
        id='financial-table',
        columns=[
            {"name": "Показатель", "id": "indicator"},
            {"name": "Значение", "id": "value"}
        ],
        data=[
            {"indicator": "Общая выручка", "value": f"{df['Доходы'].sum()} тыс. руб."},
            {"indicator": "Общие расходы", "value": f"{df['Расходы'].sum()} тыс. руб."},
            {"indicator": "Чистая прибыль", "value": f"{df['Прибыль'].sum()} тыс. руб."},
            {"indicator": "Рентабельность", "value": f"{df['Прибыль'].sum()/df['Доходы'].sum()*100:.1f}%"}
        ],
        style_table={'overflowX': 'auto'},
        style_cell={'textAlign': 'center', 'padding': '10px'},
        style_header={'backgroundColor': 'lightgrey', 'fontWeight': 'bold'}
    ),
], style={'padding': '20px'})

# Колбэки для обновления графиков
@app.callback(
    Output('time-series-graph', 'figure'),
    Input('period-dropdown', 'value')
)
def update_time_series(selected_period):
    fig = px.line(df, x='Дата', y=['Доходы', 'Расходы', 'Прибыль'],
                  title='Динамика доходов и расходов',
                  labels={'value': 'Сумма', 'variable': 'Показатель'})
    fig.update_layout(title_x=0.5)
    return fig

@app.callback(
    Output('pie-chart', 'figure'),
    Input('period-dropdown', 'value')
)
def update_pie_chart(selected_period):
    category_sum = df.groupby('Категория')['Расходы'].sum().reset_index()
    fig = px.pie(category_sum, values='Расходы', names='Категория',
                 title='Структура расходов по категориям')
    fig.update_layout(title_x=0.5)
    return fig

@app.callback(
    Output('histogram', 'figure'),
    Input('period-dropdown', 'value')
)
def update_histogram(selected_period):
    fig = px.histogram(df, x='Дата', y='Прибыль',
                       title='Распределение прибыли',
                       labels={'Прибыль': 'Сумма прибыли'})
    fig.update_layout(title_x=0.5)
    return fig

# Запуск приложения
if __name__ == '__main__':
    app.run_server(debug=True)
